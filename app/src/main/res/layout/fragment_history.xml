<?xml version="1.0" encoding="utf-8"?>
<!--
  History fragment — time-filtered charts + recent readings table
  Charts: Temperature · Humidity · MQ-3 (%) · MQ-135 (%) · MQ-4 (%)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream_bg">

    <!-- Time filter chip group -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="@color/cream_card"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip1h"
            style="@style/Widget.AgriCoolHub.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_1h"
            app:chipBackgroundColor="@color/filter_chip_bg"
            app:chipStrokeColor="@color/green_600"
            app:chipStrokeWidth="1dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip6h"
            style="@style/Widget.AgriCoolHub.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_6h"
            android:checked="true"
            app:chipBackgroundColor="@color/filter_chip_bg"
            app:chipStrokeColor="@color/green_600"
            app:chipStrokeWidth="1dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip24h"
            style="@style/Widget.AgriCoolHub.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_24h"
            app:chipBackgroundColor="@color/filter_chip_bg"
            app:chipStrokeColor="@color/green_600"
            app:chipStrokeWidth="1dp" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Error -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:textColor="@color/on_surface_variant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            style="@style/Widget.AgriCoolHub.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_retry" />
    </LinearLayout>

    <!-- Content -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Latest reading timestamp -->
                <TextView
                    android:id="@+id/tvLatestTimestamp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <!-- Temperature chart -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="3dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/cream_card"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chart_temperature"
                            style="@style/TextAppearance.AgriCoolHub.SectionHeader"
                            android:layout_marginBottom="8dp" />

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/chartTemperature"
                            android:layout_width="match_parent"
                            android:layout_height="180dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Humidity chart -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="3dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/cream_card"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chart_humidity"
                            style="@style/TextAppearance.AgriCoolHub.SectionHeader"
                            android:layout_marginBottom="8dp" />

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/chartHumidity"
                            android:layout_width="match_parent"
                            android:layout_height="180dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- MQ-3 chart -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="3dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/cream_card"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chart_mq3"
                            style="@style/TextAppearance.AgriCoolHub.SectionHeader"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mq_normalized_note"
                            android:textSize="10sp"
                            android:textColor="@color/amber_700"
                            android:layout_marginBottom="8dp" />

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/chartMq3"
                            android:layout_width="match_parent"
                            android:layout_height="160dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- MQ-135 chart -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="3dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/cream_card"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chart_mq135"
                            style="@style/TextAppearance.AgriCoolHub.SectionHeader"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mq_normalized_note"
                            android:textSize="10sp"
                            android:textColor="@color/amber_700"
                            android:layout_marginBottom="8dp" />

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/chartMq135"
                            android:layout_width="match_parent"
                            android:layout_height="160dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- MQ-4 chart -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="3dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/cream_card"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chart_mq4"
                            style="@style/TextAppearance.AgriCoolHub.SectionHeader"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mq_normalized_note"
                            android:textSize="10sp"
                            android:textColor="@color/amber_700"
                            android:layout_marginBottom="8dp" />

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/chartMq4"
                            android:layout_width="match_parent"
                            android:layout_height="160dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Recent readings table header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recent_readings"
                    style="@style/TextAppearance.AgriCoolHub.SectionHeader"
                    android:layout_marginBottom="8dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReadings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
