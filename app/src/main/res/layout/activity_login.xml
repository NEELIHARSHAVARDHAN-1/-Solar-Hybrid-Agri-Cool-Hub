<?xml version="1.0" encoding="utf-8"?>
<!--
  Login screen
  Nielsen principles applied:
  #1 Visibility of system status: progress bar shown during auth
  #3 User control and freedom:  password toggle
  #5 Error prevention: input validation before submit
  #6 Recognition rather than recall: labelled hints always visible
  #9 Help users recognize, diagnose, and recover from errors: red error message
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green_800"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="32dp"
        android:paddingTop="72dp"
        android:paddingBottom="32dp">

        <!-- Brand logo area -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_leaf"
            android:contentDescription="Agri Cool Hub Logo"
            android:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_tagline"
            android:textColor="@color/green_200"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="40dp" />

        <!-- Login card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="6dp"
            app:cardCornerRadius="16dp"
            android:layout_marginHorizontal="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/green_800"
                    android:layout_marginBottom="20dp" />

                <!-- Farmer ID field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilFarmerId"
                    style="@style/Widget.AgriCoolHub.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_farmer_id"
                    app:startIconDrawable="@drawable/ic_settings">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFarmerId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:imeOptions="actionNext"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    style="@style/Widget.AgriCoolHub.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_password"
                    android:layout_marginTop="16dp"
                    app:passwordToggleEnabled="true"
                    app:startIconDrawable="@drawable/ic_alerts">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:imeOptions="actionDone"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Error message (hidden until error) -->
                <TextView
                    android:id="@+id/tvLoginError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/red_700"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Progress bar -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/loginProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:trackCornerRadius="4dp"
                    app:indicatorColor="@color/green_600" />

                <!-- Sign in button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    style="@style/Widget.AgriCoolHub.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/btn_login"
                    android:textSize="15sp"
                    android:padding="14dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
