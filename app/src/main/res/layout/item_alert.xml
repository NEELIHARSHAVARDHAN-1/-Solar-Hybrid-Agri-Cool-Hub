<?xml version="1.0" encoding="utf-8"?>
<!--
  Alert list item card
  Severity: critical = red, warning = amber, resolved = green
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="2dp"
    app:cardCornerRadius="10dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- Status icon -->
        <ImageView
            android:id="@+id/ivAlertIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_alerts"
            android:tint="@color/red_700"
            android:contentDescription="Alert icon"
            android:layout_marginEnd="12dp" />

        <!-- Alert info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Row: alert type + severity badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvAlertType"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/red_700" />

                <!-- Severity badge: WARNING / CRITICAL -->
                <TextView
                    android:id="@+id/tvSeverityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAlertValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/on_surface_variant"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvAlertTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/on_surface_variant"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvAlertResolved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/green_700"
                android:layout_marginTop="2dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Resolve button (active alerts only) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResolve"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_resolve"
            android:textSize="12sp"
            app:strokeColor="@color/green_700"
            android:textColor="@color/green_700"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
