<?xml version="1.0" encoding="utf-8"?>
<!--
  Premium Dashboard fragment layout
  Nielsen principles fully addressed:
  #1 Visibility of system status — live indicator, ONLINE chip, loading states
  #2 Match real world — plain labels, correct units, clear ADC disclaimer
  #4 Consistency — uniform card grid, same accent bar pattern throughout
  #7 Flexibility — pull-to-refresh
  #8 Minimalist — only current readings + actionable insights visible
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_bg">

    <!-- ── Loading state ─────────────────────────────────────────────── -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="visible" />

    <!-- ── Error state ───────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="48sp" />

        <TextView
            android:id="@+id/tvErrorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_load_failed"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface_variant"
            android:textSize="13sp"
            android:textAlignment="center"
            android:layout_marginTop="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            style="@style/Widget.AgriCoolHub.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_retry" />
    </LinearLayout>

    <!-- ── Content ───────────────────────────────────────────────────── -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="24dp">

                <!-- ── Row 1: Device status card + connectivity indicator ── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDeviceStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/green_800"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/ivDeviceIcon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_dashboard"
                            android:tint="@color/white"
                            android:contentDescription="Device status" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginHorizontal="12dp">

                            <TextView
                                android:id="@+id/tvDeviceId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textStyle="bold"
                                android:textSize="15sp"
                                android:textColor="@color/white" />

                            <TextView
                                android:id="@+id/tvDeviceLastSeen"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/green_200" />
                        </LinearLayout>

                        <!-- Connectivity indicator (LIVE / STALE / OFFLINE) -->
                        <TextView
                            android:id="@+id/tvConnectivity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/conn_live"
                            android:textColor="@color/green_200"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipOnlineStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:chipBackgroundColor="@color/green_600"
                            app:chipCornerRadius="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ── Stale warning banner ────────────────────────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStaleWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="10dp"
                    app:cardBackgroundColor="@color/amber_200"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚠️"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/stale_warning"
                            android:textColor="@color/amber_700"
                            android:textSize="13sp"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ── Fruit Ripeness Card (include) ──────────────────── -->
                <include
                    android:id="@+id/cardRipeness"
                    layout="@layout/card_ripeness" />

                <!-- ── Sensor readings section header ─────────────────── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Parameters"
                    style="@style/TextAppearance.AgriCoolHub.SectionHeader"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp" />

                <!-- ── Sensor cards ─────────────────────────────────── -->
                <include layout="@layout/item_sensor_card"
                    android:id="@+id/cardTemperature" />

                <include layout="@layout/item_sensor_card"
                    android:id="@+id/cardHumidity" />

                <include layout="@layout/item_sensor_card"
                    android:id="@+id/cardMq3" />

                <include layout="@layout/item_sensor_card"
                    android:id="@+id/cardMq135" />

                <include layout="@layout/item_sensor_card"
                    android:id="@+id/cardMq4" />

                <include layout="@layout/item_sensor_card"
                    android:id="@+id/cardBattery" />

                <!-- ── Last reading timestamp ──────────────────────────── -->
                <TextView
                    android:id="@+id/tvLastReading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <!-- ── AI Insights card (include) ─────────────────────── -->
                <include
                    android:id="@+id/cardInsights"
                    layout="@layout/card_ai_insights" />

            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
