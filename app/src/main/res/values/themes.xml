<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Base application theme (Material 3 / cream palette) ───────── -->
    <style name="Theme.AgriCoolHub" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/green_700</item>
        <item name="colorPrimaryVariant">@color/green_900</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/amber_500</item>
        <item name="colorOnSecondary">@color/on_surface</item>
        <item name="colorSurface">@color/cream_card</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:colorBackground">@color/cream_bg</item>
        <item name="colorError">@color/red_700</item>
        <item name="android:statusBarColor">@color/green_900</item>
        <item name="android:navigationBarColor">@color/green_900</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimationTransition</item>
    </style>

    <!-- ── Splash ─────────────────────────────────────────────────────── -->
    <style name="Theme.AgriCoolHub.Splash" parent="Theme.AgriCoolHub">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/green_800</item>
        <item name="android:statusBarColor">@color/green_800</item>
        <item name="android:navigationBarColor">@color/green_800</item>
    </style>

    <!-- ── Window transition (shared element / fade) ─────────────────── -->
    <style name="WindowAnimationTransition">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out</item>
    </style>

    <!-- ── Card — premium white with soft shadow ─────────────────────── -->
    <style name="Widget.AgriCoolHub.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">4dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardBackgroundColor">@color/cream_card</item>
        <item name="contentPadding">0dp</item>
    </style>

    <!-- ── Card — ripeness / feature card with slight tint ───────────── -->
    <style name="Widget.AgriCoolHub.Card.Feature" parent="Widget.AgriCoolHub.Card">
        <item name="cardElevation">6dp</item>
        <item name="cardCornerRadius">20dp</item>
    </style>

    <!-- ── Sensor value text ──────────────────────────────────────────── -->
    <style name="TextAppearance.AgriCoolHub.SensorValue" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">26sp</item>
    </style>

    <!-- ── Sensor label sub-text ─────────────────────────────────────── -->
    <style name="TextAppearance.AgriCoolHub.SensorSubLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <!-- ── Section header ────────────────────────────────────────────── -->
    <style name="TextAppearance.AgriCoolHub.SectionHeader" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/green_800</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- ── Primary button ────────────────────────────────────────────── -->
    <style name="Widget.AgriCoolHub.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/green_700</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <!-- ── TextInputLayout ───────────────────────────────────────────── -->
    <style name="Widget.AgriCoolHub.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/green_700</item>
        <item name="hintTextColor">@color/green_700</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
    </style>

    <!-- ── Chip — filter ─────────────────────────────────────────────── -->
    <style name="Widget.AgriCoolHub.Chip.Filter" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipCornerRadius">20dp</item>
        <item name="checkedIconVisible">false</item>
    </style>

</resources>
