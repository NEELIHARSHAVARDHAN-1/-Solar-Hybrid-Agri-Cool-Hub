<?xml version="1.0" encoding="utf-8"?>
<!-- Navigation graph for bottom navigation fragments -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.agrihub.coolhub.ui.DashboardFragment"
        android:label="@string/nav_dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.agrihub.coolhub.ui.HistoryFragment"
        android:label="@string/nav_history"
        tools:layout="@layout/fragment_history" />

    <fragment
        android:id="@+id/alertsFragment"
        android:name="com.agrihub.coolhub.ui.AlertsFragment"
        android:label="@string/nav_alerts"
        tools:layout="@layout/fragment_alerts" />

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.agrihub.coolhub.ui.MapFragment"
        android:label="@string/nav_map"
        tools:layout="@layout/fragment_map" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.agrihub.coolhub.ui.SettingsFragment"
        android:label="@string/nav_settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
