# Backend Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ---- PostgreSQL -------------------------------------------------------------
# For local development with docker-compose: postgresql+asyncpg://agrihub:agrihub@localhost:5432/agrihub
# For cloud PostgreSQL (e.g. Railway, Render, Supabase):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# ---- MQTT — HiveMQ Cloud free tier -----------------------------------------
# MQTT_HOST: bare hostname only — no scheme (mqtts://) and no port suffix.
# Example: abc123.s1.eu.hivemq.cloud
MQTT_HOST=998559fd5537417097b01fa008399933.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=dummy_dummy
MQTT_PASSWORD=dummy_dummy+86D
# Topic patterns — must match the ESP32 firmware topic conventions.
# Use MQTT wildcard '+' for device_id segment in subscription topics.
MQTT_TOPIC_TELEMETRY=agricool/v1/devices/+/telemetry
MQTT_TOPIC_STATUS=agricool/v1/devices/+/status
MQTT_CLIENT_ID=agrihub-backend

# ---- Alert Thresholds -------------------------------------------------------
ALERT_TEMP_MAX=35.0
ALERT_HUMIDITY_MAX=90.0
# MQ thresholds are sensor output voltage in volts (0.0–6.6 V).
# The backend automatically converts raw ADC counts to voltage if the firmware
# sends integers instead of pre-converted floats.
# Formula: V = adc_raw × (3.3 / 4095) × 2  ≈ adc_raw × 0.001612
#
# Conversion reference:
#   ADC 700  → 1.128 V   (moderate gas presence)
#   ADC 1000 → 1.612 V   (elevated gas presence)
#   ADC 2000 → 3.224 V   (high gas presence — alert level)
#   ADC 3000 → 4.836 V   (very high — near sensor saturation)
#
# Defaults below correspond to ADC ≈ 1750 counts (moderate alert level):
ALERT_MQ3_MAX=2.82
ALERT_MQ135_MAX=3.23
ALERT_MQ4_MAX=2.82

# ---- Misc -------------------------------------------------------------------
DEVICE_OFFLINE_MINUTES=5
